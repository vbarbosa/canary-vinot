# Copy to docker/portal.env on the server (chmod 600). Never commit it.

# Public address of the site; used in e-mail links and to turn on secure cookies.
PORTAL_BASE_URL=https://vinot.barbosamaria.online
# Signs the login cookie. Generate once: python3 -c "import secrets; print(secrets.token_hex(32))"
PORTAL_SECRET=

# Sanity project with the landing, news and promotions (portal/cms). Public, not a secret.
SANITY_PROJECT_ID=
SANITY_DATASET=production

# E-mail (any SMTP provider). Resend: host smtp.resend.com, port 465, user "resend", password = API key.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
MAIL_FROM=nao-responda@barbosamaria.online
MAIL_FROM_NAME=VinOT

# Optional: Cloudflare Turnstile captcha on the sign-up form.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: a database user that can only touch what the portal needs (see README).
# MYSQL_USER=portal
# MYSQL_PASSWORD=

# Optional tuning
# PORTAL_MAX_CHARS=5
# PORTAL_TOWN_ID=8
# PORTAL_SIGNUPS_PER_HOUR=60
